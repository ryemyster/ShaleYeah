# Required for LLM synthesis calls
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Geowiz-compatible MCP backend for the package-local ADK agent
GEOWIZ_MCP_URL=http://127.0.0.1:3001/mcp

# Dedicated private MCP credential file; use the same file as the configured Geowiz launcher.
# Keep its directory private and its permissions 0600. Model-provider keys cannot replace it.
GEOWIZ_MCP_ACCESS_TOKEN_FILE=/absolute/private/geowiz-mcp-token

# Optional bounded transport settings (seconds; attempts include the first setup)
GEOWIZ_MCP_TIMEOUT_SECONDS=30
GEOWIZ_MCP_REQUEST_TIMEOUT_SECONDS=10
GEOWIZ_MCP_PREFLIGHT_ATTEMPTS=2

# Optional: ADK model override for app/agent.py
GEOLOGIST_ADK_MODEL=gemini-flash-latest

# Optional: path to data files (default: ./data)
DATA_PATH=./data
