# Required for LLM synthesis calls
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Geowiz-compatible MCP backend for the package-local ADK agent
GEOWIZ_MCP_URL=http://localhost:3001

# Optional: ADK model override for app/agent.py
GEOLOGIST_ADK_MODEL=gemini-flash-latest

# Optional: path to data files (default: ./data)
DATA_PATH=./data
