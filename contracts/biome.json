{
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"files": {
		"includes": [
			"src/**",
			"!src/generated.ts",
			"!src/event-generated.ts",
			"tests/**/*.ts",
			"scripts/**/*.ts",
			"*.json"
		],
		"ignoreUnknown": true
	}
}
