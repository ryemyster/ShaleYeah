{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shaleyeah:employee-contracts:0.1.0",
  "title": "EmployeeContract",
  "description": "Portable employee records. Structural validity is not authorization or professional acceptance.",
  "oneOf": [
    {
      "$ref": "#/$defs/EmployeeCharter"
    },
    {
      "$ref": "#/$defs/TaskAssignment"
    },
    {
      "$ref": "#/$defs/WorkProduct"
    },
    {
      "$ref": "#/$defs/ContextManifest"
    },
    {
      "$ref": "#/$defs/ReviewRequest"
    },
    {
      "$ref": "#/$defs/ReviewDecision"
    }
  ],
  "$defs": {
    "ContractVersion": {
      "const": "0.1.0",
      "type": "string"
    },
    "StableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{0,127}$"
    },
    "Revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "Uri": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 2048
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
    },
    "ContractErrorCode": {
      "type": "string",
      "enum": [
        "unsupported_version",
        "invalid_contract",
        "authority_denied",
        "scope_mismatch",
        "revision_mismatch",
        "missing_input",
        "source_unavailable",
        "access_denied",
        "stale_evidence",
        "conflicting_evidence",
        "approval_required",
        "unsupported_capability"
      ]
    },
    "VersionedRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "version": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "RecordRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "uri": {
          "$ref": "#/$defs/Uri"
        }
      },
      "required": [
        "id",
        "revision",
        "uri"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "customerId": {
          "$ref": "#/$defs/StableId"
        },
        "assetId": {
          "$ref": "#/$defs/StableId"
        },
        "taskId": {
          "$ref": "#/$defs/StableId"
        },
        "employeeId": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "customerId",
        "assetId",
        "taskId",
        "employeeId"
      ],
      "additionalProperties": false
    },
    "Blocker": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ContractErrorCode"
        },
        "message": {
          "$ref": "#/$defs/Text"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordRef"
          },
          "minItems": 0
        }
      },
      "required": [
        "code",
        "message",
        "references"
      ],
      "additionalProperties": false
    },
    "SourceEvidence": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "uri": {
          "$ref": "#/$defs/Uri"
        },
        "hash": {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "algorithm",
            "value"
          ],
          "additionalProperties": false
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "asOf": {
          "$ref": "#/$defs/Timestamp"
        },
        "accessClassification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "restricted",
            "licensed"
          ]
        },
        "usagePolicy": {
          "$ref": "#/$defs/VersionedRef"
        }
      },
      "required": [
        "id",
        "uri",
        "hash",
        "revision",
        "asOf",
        "accessClassification",
        "usagePolicy"
      ],
      "additionalProperties": false
    },
    "Assumption": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "statement": {
          "$ref": "#/$defs/Text"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "statement",
        "evidenceIds"
      ],
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "basis": {
          "type": "string",
          "enum": [
            "measured",
            "assumed",
            "unknown"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "$ref": "#/$defs/Text"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 0
        },
        "assumptionIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 0
        },
        "reason": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "id",
        "basis",
        "value",
        "unit",
        "evidenceIds",
        "assumptionIds"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "const": "measured"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "evidenceIds": {
                "type": "array",
                "minItems": 1
              },
              "assumptionIds": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "const": "assumed"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "assumptionIds": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "const": null
              },
              "evidenceIds": {
                "type": "array",
                "maxItems": 0
              },
              "assumptionIds": {
                "type": "array",
                "maxItems": 0
              }
            },
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "WorkReview": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unreviewed",
            "pending",
            "approved",
            "rejected",
            "changes_requested"
          ]
        },
        "decisionRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordRef"
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "decisionRefs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "approved",
                  "rejected",
                  "changes_requested"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "decisionRefs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "SharedKnowledgeRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "origin": {
          "$ref": "#/$defs/Scope"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "minItems": 1
        },
        "reviewDecisionRef": {
          "$ref": "#/$defs/RecordRef"
        },
        "usagePolicy": {
          "$ref": "#/$defs/VersionedRef"
        },
        "retentionPolicy": {
          "$ref": "#/$defs/VersionedRef"
        }
      },
      "required": [
        "artifact",
        "origin",
        "evidence",
        "reviewDecisionRef",
        "usagePolicy",
        "retentionPolicy"
      ],
      "additionalProperties": false
    },
    "AuthorityGrant": {
      "type": "object",
      "properties": {
        "employeeId": {
          "$ref": "#/$defs/StableId"
        },
        "customerId": {
          "$ref": "#/$defs/StableId"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "authorityPolicy": {
          "$ref": "#/$defs/VersionedRef"
        }
      },
      "required": [
        "employeeId",
        "customerId",
        "capabilities",
        "authorityPolicy"
      ],
      "additionalProperties": false
    },
    "EmployeeCharter": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/ContractVersion"
        },
        "kind": {
          "type": "string",
          "const": "employee-charter"
        },
        "employeeId": {
          "$ref": "#/$defs/StableId"
        },
        "displayName": {
          "$ref": "#/$defs/Text"
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "minItems": 0
        },
        "role": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/StableId"
            },
            "name": {
              "$ref": "#/$defs/Text"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        },
        "owner": {
          "type": "object",
          "properties": {
            "principalId": {
              "$ref": "#/$defs/StableId"
            },
            "customerId": {
              "$ref": "#/$defs/StableId"
            }
          },
          "required": [
            "principalId",
            "customerId"
          ],
          "additionalProperties": false
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "minItems": 1
        },
        "nonGoals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "minItems": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "inputTypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersionedRef"
          },
          "minItems": 1
        },
        "outputTypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersionedRef"
          },
          "minItems": 1
        },
        "authorityPolicy": {
          "$ref": "#/$defs/VersionedRef"
        },
        "sourcePolicy": {
          "$ref": "#/$defs/VersionedRef"
        },
        "contextPolicy": {
          "$ref": "#/$defs/VersionedRef"
        },
        "contextIsolation": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "customer",
              "asset",
              "task",
              "employee"
            ]
          },
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        },
        "evalProfiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersionedRef"
          },
          "minItems": 1
        }
      },
      "required": [
        "contractVersion",
        "kind",
        "employeeId",
        "displayName",
        "role",
        "owner",
        "responsibilities",
        "nonGoals",
        "capabilities",
        "inputTypes",
        "outputTypes",
        "authorityPolicy",
        "sourcePolicy",
        "contextPolicy",
        "contextIsolation",
        "evalProfiles"
      ],
      "additionalProperties": false
    },
    "TaskAssignment": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/ContractVersion"
        },
        "kind": {
          "type": "string",
          "const": "task-assignment"
        },
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "outcome": {
          "$ref": "#/$defs/Text"
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 0
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "minItems": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "assigned",
            "running",
            "awaiting_review",
            "blocked",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "workProductRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 0
        },
        "reviewDecisionRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordRef"
          },
          "minItems": 0
        }
      },
      "required": [
        "contractVersion",
        "kind",
        "id",
        "revision",
        "scope",
        "outcome",
        "requiredCapabilities",
        "inputs",
        "constraints",
        "status",
        "workProductRefs",
        "reviewDecisionRefs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "workProductRefs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "WorkProduct": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/ContractVersion"
        },
        "kind": {
          "type": "string",
          "const": "work-product"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "taskRevision": {
          "$ref": "#/$defs/Revision"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "ready_for_review",
            "blocked",
            "failed",
            "final"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "minItems": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "minItems": 0
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assumption"
          },
          "minItems": 0
        },
        "uncertainty": {
          "$ref": "#/$defs/Text"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Blocker"
          },
          "minItems": 0
        },
        "review": {
          "$ref": "#/$defs/WorkReview"
        }
      },
      "required": [
        "contractVersion",
        "kind",
        "scope",
        "taskRevision",
        "artifact",
        "status",
        "inputs",
        "evidence",
        "findings",
        "assumptions",
        "uncertainty",
        "blockers",
        "review"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "ready_for_review",
                  "final"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "type": "array",
                "minItems": 1
              },
              "evidence": {
                "type": "array",
                "minItems": 1
              },
              "findings": {
                "type": "array",
                "minItems": 1
              },
              "blockers": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "blocked",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "blockers": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "final"
              }
            }
          },
          "then": {
            "properties": {
              "review": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "approved"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ContextManifest": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/ContractVersion"
        },
        "kind": {
          "type": "string",
          "const": "context-manifest"
        },
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "taskRevision": {
          "$ref": "#/$defs/Revision"
        },
        "contextPolicy": {
          "$ref": "#/$defs/VersionedRef"
        },
        "selectedEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "minItems": 0
        },
        "workingArtifactRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 0
        },
        "sharedKnowledge": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SharedKnowledgeRef"
          },
          "minItems": 0
        },
        "assembledAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "retention": {
          "type": "object",
          "properties": {
            "policy": {
              "$ref": "#/$defs/VersionedRef"
            },
            "expiresAt": {
              "$ref": "#/$defs/Timestamp"
            }
          },
          "required": [
            "policy",
            "expiresAt"
          ],
          "additionalProperties": false
        },
        "budget": {
          "type": "object",
          "properties": {
            "maxItems": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000000
            },
            "maxTokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "maxItems",
            "maxBytes",
            "maxTokens"
          ],
          "additionalProperties": false
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Blocker"
          },
          "minItems": 0
        }
      },
      "required": [
        "contractVersion",
        "kind",
        "id",
        "revision",
        "scope",
        "taskRevision",
        "contextPolicy",
        "selectedEvidence",
        "workingArtifactRefs",
        "sharedKnowledge",
        "assembledAt",
        "retention",
        "budget",
        "blockers"
      ],
      "additionalProperties": false
    },
    "ReviewRequest": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/ContractVersion"
        },
        "kind": {
          "type": "string",
          "const": "review-request"
        },
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "taskRevision": {
          "$ref": "#/$defs/Revision"
        },
        "productRef": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "requestedDecision": {
          "$ref": "#/$defs/Text"
        },
        "reviewerPolicy": {
          "$ref": "#/$defs/VersionedRef"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "contractVersion",
        "kind",
        "id",
        "revision",
        "scope",
        "taskRevision",
        "productRef",
        "requestedDecision",
        "reviewerPolicy",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "ReviewDecision": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/ContractVersion"
        },
        "kind": {
          "type": "string",
          "const": "review-decision"
        },
