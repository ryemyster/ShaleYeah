{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["UV_CACHE_DIR", "UV_OFFLINE"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "type-check": {
      "dependsOn": ["^build"]
    }
  }
}
