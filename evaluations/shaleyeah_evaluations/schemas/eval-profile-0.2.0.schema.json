{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shaleyeah:eval-profile:0.2.0",
  "title": "Employee performance evaluation profile 0.2.0",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.2.0"
    },
    "kind": {
      "const": "eval-profile"
    },
    "profileRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "roleId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "registryVersion": {
      "const": "0.2.0"
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uri": {
            "type": "string",
            "pattern": "^urn:sha256:[a-f0-9]{64}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "revision",
          "uri",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "parameters": {
            "type": "object"
          },
          "threshold": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "hardGate": {
            "type": "boolean"
          },
          "onFailure": {
            "enum": [
              "block",
              "review",
              "warn"
            ]
          },
          "rubric": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            ]
          },
          "judgeRef": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._:-]{1,128}$"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "id",
                  "version"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "version",
          "parameters",
          "threshold",
          "weight",
          "hardGate",
          "onFailure",
          "rubric",
          "judgeRef"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    },
    "aggregateThreshold": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "failureAction": {
      "enum": [
        "block",
        "review"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "profileRef",
    "roleId",
    "registryVersion",
    "datasets",
    "metrics",
    "aggregateThreshold",
    "failureAction"
  ],
  "additionalProperties": false
}
