# Optional private assigned-task/source/review/model binding, owned and mode 0600.
# MARKET_CONFIG_FILE=/absolute/private/market.json

# Protected HTTP helper configuration, including explicit token, principal and audit.
# MARKET_HTTP_CONFIG_FILE=/absolute/private/market-http.json

# Optional EIA benchmark access. Missing/failed access leaves unavailable prices.
EIA_API_KEY=

# Optional advisory observation file, separate from assigned employee sources.
# MARKET_SOURCE_FILE=/absolute/private/market-sources.json
MARKET_MAX_OBSERVATION_AGE_SECONDS=604800

# Advisory models use the binding's modelConfigFile or host modelRuntime.
# Model and MCP credentials belong in separate private files.
DATA_PATH=./data
