# Optional shared model interpretation. Keep real values outside version control.
ANTHROPIC_API_KEY=

# Optional EIA benchmark access. Missing/failed access leaves unavailable prices.
EIA_API_KEY=

# Optional absolute path to an owned private JSON source file (mode 0600).
# MARKET_SOURCE_FILE=/absolute/private/market-sources.json

# Host analysis freshness policy in seconds; retrieval time never renews observation age.
MARKET_MAX_OBSERVATION_AGE_SECONDS=604800

# Shared MCP runtime data directory.
DATA_PATH=./data
