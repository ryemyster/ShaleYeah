# Required for LLM synthesis calls
ANTHROPIC_API_KEY=sk-ant-...

# Optional: free EIA commodity price data (WTI crude, Henry Hub gas)
# Get a free key at https://www.eia.gov/opendata/register.php
# Without this, the server uses hardcoded price constants
EIA_API_KEY=

# Optional: path to data files (default: ./data)
DATA_PATH=./data
